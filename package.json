{
  "name": "graphql-filter-fragment",
  "description": "Filters a data structure by a GraphQL fragment",
  "version": "1.2.0",
  "license": "MIT",
  "author": "Jan Amann <jan@amann.me>",
  "homepage": "https://github.com/amannn/graphql-filter-fragment",
  "scripts": {
    "build": "bunchee --sourcemap",
    "test": "vitest run",
    "lint": "eslint src test",
    "prepare": "pnpm build",
    "build:check": "attw --pack . --ignore-rules cjs-only-exports-default"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/graphql-filter-fragment.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "graphql"
  ],
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "bunchee": "6.12.2",
    "eslint": "9.39.5",
    "eslint-config-molindo": "8.0.0",
    "graphql": "17.0.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  }
}
